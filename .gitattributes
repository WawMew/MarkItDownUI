# 换行与编码策略
# ---------------------------------------------------------------------------
# 默认：文本文件在仓库内统一存为 LF，检出时也保持 LF。
# 配合仓库级 core.autocrlf=false 使用，行为完全可预期。
* text=auto eol=lf

# Windows 批处理：GBK 编码 + CRLF 换行
# 必须显式声明为「非文本」（-text），禁止任何换行规范化与编码转换。
# 原因：这两个文件是 GBK 中文内容，一旦被转成 UTF-8 或 LF，
#   1) chcp 936 下中文注释全部乱码；
#   2) 换行变 LF 后部分场景下批处理解析异常。
# 本仓库已验证：磁盘文件与 git blob 逐字节一致（CRLF 分别保留 38 / 57 个）。
*.bat  -text
*.cmd  -text

# 二进制文件：不做 diff、不做换行转换
# ⚠️ .gitattributes 每行只能写一个 pattern（与 .gitignore 不同），
#    写成 "*.exe *.dll binary" 会让 git 把第 2 个 token 当成属性名而报错。
*.exe   binary
*.dll   binary
*.ico   binary
*.icns  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.docx  binary
*.doc   binary
*.xlsx  binary
*.xls   binary
*.pptx  binary
*.ppt   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.gz    binary
*.tar   binary
*.epub  binary
*.msg   binary
*.mp3   binary
*.wav   binary
*.m4a   binary
*.mp4   binary

# 明确文本类文件的换行
*.py    text eol=lf
*.spec  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.html  text eol=lf
*.xml   text eol=lf
LICENSE        text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
requirements.txt  text eol=lf

# GitHub 语言统计：PyInstaller 配置本质是 Python 脚本
*.spec linguist-language=Python
